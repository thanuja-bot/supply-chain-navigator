# ============================================================
# Governed, Auditable AI Content Pipeline — Environment Config
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ---------------------------------------------------------------------------
# Required: OpenAI API key for all 4 agents
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Optional: Database URL
# Default is SQLite (local file). For production use PostgreSQL.
# ---------------------------------------------------------------------------
# SQLite (default — no setup required):
DATABASE_URL=sqlite:///./ai_pipeline.db

# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_pipeline

# ---------------------------------------------------------------------------
# Optional: Server settings
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
